APP_NAME="NileBit POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.nilebitlabs.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DATABASE_URL=
DB_SSLMODE=require

CORS_ALLOWED_ORIGINS=https://pos.nilebitlabs.com,https://nilebitlabs.com
PUBLIC_REGISTRATION=false
# Set true only for Render's free public-beta deployment. Paid deployments use a pre-deploy migration.
RUN_MIGRATIONS_ON_BOOT=false
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=local

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ASK_DAILY_LIMIT=200
